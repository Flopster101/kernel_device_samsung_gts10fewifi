/* NEED TO FIX IF YOU WANT USE THIS */

&pinctrl_1 {
	himax_tsp_int_active: himax_tsp_int_active {
		GPIO_CONFIG_PUD_DRV(AP,gpm2,gpm2,0, FUNC_INPUT_WAKEUP, PULL_NONE, DRV_LV4);
	};

	himax_int_sleep: himax_tsp_int_sleep {
		GPIO_CONFIG_PUD_DRV(AP,gpm2,gpm2,0, FUNC_INPUT, PULL_DOWN, DRV_LV1);
	};
};

&pinctrl_0 {
	himax_tsp_rst_active: himax_tsp_rst_active {
		GPIO_CONFIG_PUD_DRV(AP,gpc6,gpc6,0, FUNC_OUTPUT, PULL_NONE, DRV_LV1);
	};

	himax_tsp_rst_sleep: himax_tsp_rst_sleep {
		GPIO_CONFIG_PUD_DRV(AP,gpc6,gpc6,0, FUNC_INPUT, PULL_DOWN, DRV_LV1);
	};
};

&pinctrl_3 {
	himax_tsp_on_cs: himax_tsp_on_cs {
		GPIO_CONFIG_PUD_DRV(AP,gpp0,gpp0,3, FUNC_OUTPUT_HIGH, PULL_NONE, DRV_LV1);
	};
	himax_tsp_off_cs: himax_tsp_off_cs {
		GPIO_CONFIG_PUD_DRV(AP,gpp0,gpp0,3, FUNC_OUTPUT_LOW, PULL_NONE, DRV_LV1);
	};
};

&pinctrl_3 {
	himax_tsp_on_clk: himax_tsp_on_clk {
		samsung,pins = SEC_GPIO(AP,gpp0,gpp0,0);
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	himax_tsp_off_clk: himax_tsp_off_clk {
		GPIO_CONFIG_PUD_DRV(AP,gpp0,gpp0,0, FUNC_INPUT, PULL_DOWN, DRV_LV1);
	};

	himax_tsp_on_mosi: himax_tsp_on_mosi {
		samsung,pins = SEC_GPIO(AP,gpp0,gpp0,1);
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	himax_tsp_off_mosi: himax_tsp_off_mosi {
		GPIO_CONFIG_PUD_DRV(AP,gpp0,gpp0,1, FUNC_INPUT, PULL_DOWN, DRV_LV1);
	};

	himax_tsp_on_miso: himax_tsp_on_miso {
		samsung,pins = SEC_GPIO(AP,gpp0,gpp0,2);
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};

	himax_tsp_off_miso: himax_tsp_off_miso {
		GPIO_CONFIG_PUD_DRV(AP,gpp0,gpp0,2, FUNC_INPUT, PULL_DOWN, DRV_LV1);
	};
};


&spi_0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";
	num-cs = <1>;

	tsp_himax: himax_ts@0 {
		status = "okay";
		compatible = "himax,hxcommon";
		reg = <0>;

		pinctrl-names = "on_state", "off_state";
		pinctrl-0 = <&himax_tsp_int_active &himax_tsp_rst_active>;
		pinctrl-1 = <&himax_int_sleep &himax_tsp_rst_sleep>;

		spi-max-frequency = <10000000>;
		himax,rst-gpio = <SEC_GPIO_REF(AP,gpc6,gpc6,0) 0x00>;
		sec,irq_gpio = <SEC_GPIO_REF(AP,gpm2,gpm2,0) 0x00>;
		sec,gpio_spi_cs = <SEC_GPIO_REF(AP,gpp0,gpp0,3) 0>;

		sec,enable_sysinput_enabled;
		support_dex_mode;
		support_vbus_notifier;
		not_support_vdd; // use himax driver power control

		controller-data {
			samsung,spi-feedback-delay = <0>;
		};
	};
};

/* /home/dpi/qb5_8814/workspace/P4_1716/kernel/kmodule/input/sec_input_2025/touchscreen/himax/hx83xxx_spi/dts/input-lsi-tsp-hx83xxx_spi.gts10fe(wifi).dtsi */
&pinctrl_0 {
	himax_tsp_rst_active_out: himax_tsp_rst_active_out {
		GPIO_CONFIG_PUD_DRV(AP,gpc6,gpc6,0, FUNC_OUTPUT, PULL_NONE, DRV_LV1);
//		samsung,pin-val = <1>;
		samsung,pin-con-pdn = <3>;    // PREV in sleep
		samsung,pin-pud-pdn = <0>;    // NP in sleeps
	};
};

&spi_0 {
	pinctrl-names = "";
	num-cs = <2>;
};

&tsp_himax {
	pinctrl-names = "on_state", "off_state";
	pinctrl-0 = <&himax_tsp_int_active &himax_tsp_rst_active_out &himax_tsp_on_clk
			&himax_tsp_on_mosi &himax_tsp_on_miso &himax_tsp_on_cs>;
	pinctrl-1 = <&himax_int_sleep &himax_tsp_rst_sleep &himax_tsp_off_clk
			&himax_tsp_off_mosi &himax_tsp_off_miso &himax_tsp_off_cs>;

	sec,max_coords = <1440 2304>;
	himax,display-coords = <1440 2304>;
	himax,fix_touch_info = <48 32 0 1440 2304 10 1 1>;
	//FIX_HX_RX_NUM,FIX_HX_TX_NUM,FIX_HX_BT_NUM,FIX_HX_X_RES,FIX_HX_Y_RES,FIX_HX_MAX_PT,FIX_HX_XY_REVERSE
	himax,project_name = "GTS10FE", "X526";

	sec,bitmask_unload = <0x00FF00 0x00F200>; // unload if novatek lcd
	sec,firmware_name = "tsp_himax/hx83102j_gts10fe.bin";

	himax,name_lcd_rst = "lcd_rst";
	// regulator order: vddi, bl en, vsp, vsn, boost en
	himax,regulator_name = "lcd_vddi", "lcd_bl_en", "lcd_vsp", "lcd_vsn", "lcd_bl_en_2";

#if 0
	himax,vendor_check-gpio = <SEC_GPIO_REF(NC) 0>;
	himax,vendor_check_enable_value = <0>;
#endif

	himax,one_frame_delay = <20>;
	himax,report_type = <1>;

	enable_settings_aot;

	controller-data {
		//cs-gpio = <SEC_GPIO_REF(AP,gpp0,gpp0,3) 0>;
		samsung,spi-feedback-delay = <0>;
		samsung,spi-chip-select-mode = <0>;
	};
};
