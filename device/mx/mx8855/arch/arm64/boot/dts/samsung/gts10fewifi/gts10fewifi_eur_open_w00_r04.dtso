/ {
	fragment@panel_drv {
		target-path = "/";
		__overlay__ {
			panel_drv_0: panel_drv_0 {
				status = "okay";
				compatible = "samsung,panel-drv";
				panel,id = <0>;

				nt36523n_gts10fe_csot_power_ctrl:
				nt36523n_gts10fe_csot_power_ctrl {
					actions {
						nt36523n_gts10fe_csot_iovcc_on: iovcc-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_iovcc>;
						};
						nt36523n_gts10fe_csot_iovcc_off: iovcc-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_iovcc>;
						};
						nt36523n_gts10fe_csot_delay_1ms: delay-1ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <1>;
						};
						nt36523n_gts10fe_csot_delay_2ms: delay-2ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <2>;
						};
						nt36523n_gts10fe_csot_delay_3ms: delay-3ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <3>;
						};
						nt36523n_gts10fe_csot_delay_5ms: delay-5ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <5>;
						};
						nt36523n_gts10fe_csot_delay_10ms: delay-10ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <10>;
						};
						nt36523n_gts10fe_csot_delay_15ms: delay-15ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <15>;
						};
						nt36523n_gts10fe_csot_delay_17ms: delay-17ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <17>;
						};
						nt36523n_gts10fe_csot_delay_60ms: delay-60ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <60>;
						};
						nt36523n_gts10fe_csot_delay_70ms: delay-70ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <70>;
						};
						nt36523n_gts10fe_csot_delay_115ms: delay-115ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <115>;
						};
						nt36523n_gts10fe_csot_delay_120ms: delay-120ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <120>;
						};
						nt36523n_gts10fe_csot_reset_high: reset-high {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_reset>;
						};
						nt36523n_gts10fe_csot_reset_low: reset-low {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_reset>;
						};						
						nt36523n_gts10fe_csot_blic_en1_on: blic-en1-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_en1>;
						};
						nt36523n_gts10fe_csot_blic_en1_off: blic-en1-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_en1>;
						};
						nt36523n_gts10fe_csot_blic_en2_on: blic-en2-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_en2>;
						};
						nt36523n_gts10fe_csot_blic_en2_off: blic-en2-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_en2>;
						};
						nt36523n_gts10fe_csot_blic_on: blic-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic>;
						};
						nt36523n_gts10fe_csot_blic_off: blic-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic>;
						};
						nt36523n_gts10fe_csot_blic_booster_on: bli-booster-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_2>;
						};
						nt36523n_gts10fe_csot_blic_booster_off: bli-booster-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_2>;
						};
					};
					sequences {
						panel_boot_on = <
							&nt36523n_gts10fe_csot_blic_booster_on
							&nt36523n_gts10fe_csot_iovcc_on
							&nt36523n_gts10fe_csot_blic_on
							&nt36523n_gts10fe_csot_blic_en1_on
							&nt36523n_gts10fe_csot_blic_en2_on
							&nt36523n_gts10fe_csot_reset_high
						>;

						panel_power_on = <
							&nt36523n_gts10fe_csot_blic_booster_on
							&nt36523n_gts10fe_csot_delay_5ms
							&nt36523n_gts10fe_csot_iovcc_on
							&nt36523n_gts10fe_csot_delay_5ms
							&nt36523n_gts10fe_csot_blic_on
							&nt36523n_gts10fe_csot_delay_5ms
							&nt36523n_gts10fe_csot_blic_en1_on
							&nt36523n_gts10fe_csot_delay_5ms
							&nt36523n_gts10fe_csot_blic_en2_on
							&nt36523n_gts10fe_csot_delay_10ms
						>;
						panel_power_off = <
							&nt36523n_gts10fe_csot_delay_70ms
							&nt36523n_gts10fe_csot_reset_low
							&nt36523n_gts10fe_csot_delay_1ms
							&nt36523n_gts10fe_csot_blic_en2_off
							&nt36523n_gts10fe_csot_delay_2ms
							&nt36523n_gts10fe_csot_blic_en1_off
							&nt36523n_gts10fe_csot_delay_2ms
							&nt36523n_gts10fe_csot_blic_off
							&nt36523n_gts10fe_csot_delay_3ms
							&nt36523n_gts10fe_csot_blic_booster_off
							&nt36523n_gts10fe_csot_delay_5ms
							&nt36523n_gts10fe_csot_iovcc_off
							&nt36523n_gts10fe_csot_delay_115ms
						>;
						panel_reset_lp11 = <
							&nt36523n_gts10fe_csot_delay_15ms
							&nt36523n_gts10fe_csot_reset_high
							&nt36523n_gts10fe_csot_delay_2ms
							&nt36523n_gts10fe_csot_reset_low
							&nt36523n_gts10fe_csot_delay_2ms
							&nt36523n_gts10fe_csot_reset_high
							&nt36523n_gts10fe_csot_delay_17ms
						>;
					};
				};

				nt36523n_gts10fe_csot_ap: nt36523n_gts10fe_csot_ap {
					/* SLSI */
					SLSI,size = <147 235>;
					SLSI,hdr_formats = <(HDR_FORMAT_HDR10 | HDR_FORMAT_HLG)>;
					SLSI,hdr_max_luma = <4500000>;	/* 450 */
					SLSI,hdr_max_avg_luma = <1200000>;	/* 120 */
					SLSI,hdr_min_luma = <5>;		/* 0.0005 */
					/* DSC PPS vender setting (optional) */
					SLSI,vendor_pps_enable;
					SLSI,initial_dec_delay = <616>;	// 0x268
					SLSI,reset_pos = <1>; 	/* 0: LP00, 1: LP11, 2: LP11_HS(def) */
				};

				panels {
					nt36523n_gts10fe_csot: nt36523n_gts10fe_csot {
						ap-vendor-setting = <&nt36523n_gts10fe_csot_ap>;
						display-mode = <&nt36523n_gts10fe_csot_panel_display_modes>;
						power-ctrl = <&nt36523n_gts10fe_csot_power_ctrl>;
						dqe-suffix = "nt36523n_gts10fe";
						id-mask = <
							PANEL_ID(0x4CF240) PANEL_MASK(0xFFFFFF)
							PANEL_ID(0x57F241) PANEL_MASK(0xFFFFFF)
							PANEL_ID(0x000000) PANEL_MASK(0x000000)
						>;
					};
				};
			};
		};
	};
};


/* #include "../display_blic_ktz8868.dtsi" */        /* From display_blic_ktz8868.py */
/*
 * Samsung Exynos SoC series Panel driver
 *
 * Copyright (c) 2020 Samsung Electronics Co., Ltd
 *
 * This program is free software; you can redistribute it and/or modify
 * it under the terms of the GNU General Public License version 2 as
 * published by the Free Software Foundation.
 */

#if 1
#define KTZ8868_1st
#endif

#include <dt-bindings/display/panel-display.h>
/ {
	fragment@panel_drv {
		target-path = "/";
		__overlay__ {
			panel_blic: panel_blic {
				ktz8868 {
					name = "ktz8868";
					i2c,reg = <0x11>;
					i2c,match = <0x01 0x00 0x00>; /* addr mask val */

					power_ctrl {
						actions {
							ktz8868_gpio_hwen_on: ktz8868_gpio_hwen_on {
								type = <PCTRL_GPIO_ENABLE>;
#if defined(KTZ8868_1st)
								gpio = <&gpio_hwen>;
#endif
#if defined(KTZ8868_2nd)
								gpio = <&gpio_hwen_2>;
#endif
							};

							/*
							ktz8868_gpio_hwen_off: ktz8868_gpio_hwen_off {
								type = <PCTRL_GPIO_DISABLE>;
								gpio = <&gpio_hwen>;
							};
							ktz8868_gpio_vsp_on: ktz8868_gpio_vsp_on {
								type = <PCTRL_GPIO_ENABLE>;
								gpio = <&gpio_vsp>;
							};
							ktz8868_gpio_vsp_off: ktz8868_gpio_vsp_off {
								type = <PCTRL_GPIO_DISABLE>;
								gpio = <&gpio_vsp>;
							};
							ktz8868_gpio_vsn_on: ktz8868_gpio_vsn_on {
								type = <PCTRL_GPIO_ENABLE>;
								gpio = <&gpio_vsn>;
							};
							ktz8868_gpio_vsn_off: ktz8868_gpio_vsn_off {
								type = <PCTRL_GPIO_DISABLE>;
								gpio = <&gpio_vsn>;
							};
							*/

							ktz8868_delay_2ms: ktz8868-delay-2ms {
								type = <PCTRL_DELAY_MSLEEP>;
								value = <2>;
							};

						};

						sequences {
							panel_blic_pre_on = <&ktz8868_gpio_hwen_on &ktz8868_delay_2ms>;
							/* panel_blic_post_on = <&ktz8868_gpio_vsp_on &ktz8868_delay_2ms &ktz8868_gpio_vsn_on &ktz8868_delay_2ms >; */
							/* panel_blic_pre_off = <&ktz8868_gpio_vsn_off &ktz8868_delay_2ms  &ktz8868_gpio_vsp_off &ktz8868_delay_2ms >; */
							/* KTZ: DO NOT turn off IC EN */
							/* panel_blic_post_off = <&ktz8868_gpio_hwen_off>; */
						};
					};
				};
			};
		};
	};
};


