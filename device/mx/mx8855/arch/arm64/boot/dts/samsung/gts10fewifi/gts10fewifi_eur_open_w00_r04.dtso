/ {
	fragment@panel_drv {
		target-path = "/";
		__overlay__ {
			panel_drv_0: panel_drv_0 {
				status = "okay";
				compatible = "samsung,panel-drv";
				panel,id = <0>;

				hx83102j_gts10fe_boe_power_ctrl:
				hx83102j_gts10fe_boe_power_ctrl {
					actions {
						hx83102j_gts10fe_boe_iovcc_on: iovcc-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_iovcc>;
						};
						hx83102j_gts10fe_boe_iovcc_off: iovcc-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_iovcc>;
						};
						hx83102j_gts10fe_boe_delay_1ms: delay-1ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <1>;
						};
						hx83102j_gts10fe_boe_delay_2ms: delay-2ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <2>;
						};
						hx83102j_gts10fe_boe_delay_3ms: delay-3ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <3>;
						};
						hx83102j_gts10fe_boe_delay_5ms: delay-5ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <5>;
						};
						hx83102j_gts10fe_boe_delay_10ms: delay-10ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <10>;
						};
						hx83102j_gts10fe_boe_delay_15ms: delay-15ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <15>;
						};
						hx83102j_gts10fe_boe_delay_17ms: delay-17ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <17>;
						};
						hx83102j_gts10fe_boe_delay_60ms: delay-60ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <60>;
						};
						hx83102j_gts10fe_boe_delay_70ms: delay-70ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <70>;
						};
						hx83102j_gts10fe_boe_delay_115ms: delay-115ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <115>;
						};
						hx83102j_gts10fe_boe_delay_120ms: delay-120ms {
							type = <PCTRL_DELAY_MSLEEP>;
							value = <120>;
						};
						hx83102j_gts10fe_boe_reset_high: reset-high {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_reset>;
						};
						hx83102j_gts10fe_boe_reset_low: reset-low {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_reset>;
						};
						
						hx83102j_gts10fe_boe_blic_en1_on: blic-en1-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_en1>;
						};
						hx83102j_gts10fe_boe_blic_en1_off: blic-en1-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_en1>;
						};
						hx83102j_gts10fe_boe_blic_en2_on: blic-en2-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_en2>;
						};
						hx83102j_gts10fe_boe_blic_en2_off: blic-en2-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_en2>;
						};						
						hx83102j_gts10fe_boe_blic_on: blic-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic>;
						};
						hx83102j_gts10fe_boe_blic_off: blic-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic>;
						};
						hx83102j_gts10fe_boe_blic_booster_on: bli-booster-on {
							type = <PCTRL_REGULATOR_ENABLE>;
							reg = <&ddi_blic_2>;
						};
						hx83102j_gts10fe_boe_blic_booster_off: bli-booster-off {
							type = <PCTRL_REGULATOR_DISABLE>;
							reg = <&ddi_blic_2>;
						};
					};
					sequences {
						panel_boot_on = <
							&hx83102j_gts10fe_boe_blic_booster_on
							&hx83102j_gts10fe_boe_iovcc_on
							&hx83102j_gts10fe_boe_blic_on
							&hx83102j_gts10fe_boe_blic_en1_on
							&hx83102j_gts10fe_boe_blic_en2_on
							&hx83102j_gts10fe_boe_reset_high
						>;

						panel_power_on = <
							&hx83102j_gts10fe_boe_blic_booster_on
							&hx83102j_gts10fe_boe_delay_5ms
							&hx83102j_gts10fe_boe_iovcc_on
							&hx83102j_gts10fe_boe_delay_5ms
							&hx83102j_gts10fe_boe_blic_on
							&hx83102j_gts10fe_boe_delay_5ms
							&hx83102j_gts10fe_boe_blic_en1_on
							&hx83102j_gts10fe_boe_delay_5ms
							&hx83102j_gts10fe_boe_blic_en2_on
							&hx83102j_gts10fe_boe_delay_10ms
						>;
						panel_power_off = <
							&hx83102j_gts10fe_boe_delay_70ms
							&hx83102j_gts10fe_boe_reset_low
							&hx83102j_gts10fe_boe_delay_1ms
							&hx83102j_gts10fe_boe_blic_en2_off
							&hx83102j_gts10fe_boe_delay_2ms
							&hx83102j_gts10fe_boe_blic_en1_off
							&hx83102j_gts10fe_boe_delay_2ms
							&hx83102j_gts10fe_boe_blic_off
							&hx83102j_gts10fe_boe_delay_3ms
							&hx83102j_gts10fe_boe_blic_booster_off
							&hx83102j_gts10fe_boe_delay_5ms
							&hx83102j_gts10fe_boe_iovcc_off
							&hx83102j_gts10fe_boe_delay_115ms
						>;
						panel_reset_lp11 = <
							&hx83102j_gts10fe_boe_delay_15ms
							&hx83102j_gts10fe_boe_reset_high
							&hx83102j_gts10fe_boe_delay_2ms
							&hx83102j_gts10fe_boe_reset_low
							&hx83102j_gts10fe_boe_delay_2ms
							&hx83102j_gts10fe_boe_reset_high
							&hx83102j_gts10fe_boe_delay_17ms
						>;
					};
				};

				hx83102j_gts10fe_boe_ap: hx83102j_gts10fe_boe_ap {
					/* SLSI */
					SLSI,size = <147 235>;
					SLSI,hdr_formats = <(HDR_FORMAT_HDR10 | HDR_FORMAT_HLG)>;
					SLSI,hdr_max_luma = <4500000>;	/* 450 */
					SLSI,hdr_max_avg_luma = <1200000>;	/* 120 */
					SLSI,hdr_min_luma = <5>;		/* 0.0005 */
					/* DSC PPS vender setting (optional) */
					SLSI,vendor_pps_enable;
					SLSI,initial_dec_delay = <616>;	// 0x268
					SLSI,reset_pos = <1>; 	/* 0: LP00, 1: LP11, 2: LP11_HS(def) */
				};

				panels {
					hx83102j_gts10fe_boe: hx83102j_gts10fe_boe {
						ap-vendor-setting = <&hx83102j_gts10fe_boe_ap>;
						display-mode = <&hx83102j_gts10fe_boe_panel_display_modes>;
						power-ctrl = <&hx83102j_gts10fe_boe_power_ctrl>;
						dqe-suffix = "hx83102j_gts10fe";
						id-mask = <
							PANEL_ID(0x4CD230) PANEL_MASK(0xFFFFFF)
							PANEL_ID(0x5CD230) PANEL_MASK(0xFFFFFF)
							PANEL_ID(0x000000) PANEL_MASK(0x000000)
						>;
					};
				};
			};
		};
	};
};


/* #include "../display_blic_max77816.dtsi" */       /* From display_blic_max77816.py */
/*
 * Samsung Exynos SoC series Panel driver
 *
 * Copyright (c) 2020 Samsung Electronics Co., Ltd
 *
 * This program is free software; you can redistribute it and/or modify
 * it under the terms of the GNU General Public License version 2 as
 * published by the Free Software Foundation.
 */

#if 1
#define MAX77816_2nd
#endif

#include <dt-bindings/display/panel-display.h>
/ {
	fragment@panel_drv {
		target-path = "/";
		__overlay__ {
			panel_blic: panel_blic {
				max77816 {
					name = "max77816";
					i2c,reg = <0x18>;
					i2c,match = <0x00 0x00 0x00>; /* addr mask val */

					power_ctrl {
						actions {
							max77816_gpio_hwen_on: max77816_gpio_hwen_on {
								type = <PCTRL_GPIO_ENABLE>;
#if defined(MAX77816_1st)
								gpio = <&gpio_hwen>;
#endif
#if defined(MAX77816_2nd)
								gpio = <&gpio_hwen_2>;
#endif	
							};
							max77816_gpio_hwen_off: max77816_gpio_hwen_off {
								type = <PCTRL_GPIO_DISABLE>;
#if defined(MAX77816_1st)
								gpio = <&gpio_hwen>;
#endif
#if defined(MAX77816_2nd)
								gpio = <&gpio_hwen_2>;
#endif
							};
							max77816_delay_2ms: max77816_delay_2ms {
								type = <PCTRL_DELAY_MSLEEP>;
								value = <2>;
							};
						};

						sequences {
							panel_blic_pre_on = <&max77816_gpio_hwen_on &max77816_delay_2ms>;
							panel_blic_post_off = <&max77816_delay_2ms &max77816_gpio_hwen_off>;
						};
					};
				};
			};
		};
	};
};


/* #include "../samsung_6_1.dtsi" */                 /* From samsung_6_1.py */
