#include <dt-bindings/display/panel-display.h>
#include <dt-bindings/display/exynos-display.h>

&dsim_modes {
	1440x2304@60hs {
		exynos,pmsk = <
			0x7 0xAA 0x1 0x8800 /* p m s k */
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0
			>;
		exynos,hs-clk = <930>;
		exynos,esc-clk = <20>;
	};
	1440x2304@90hs {
		exynos,pmsk = <
			0x7 0xAA 0x1 0x8800 /* p m s k */
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0
			>;
		exynos,hs-clk = <930>;
		exynos,esc-clk = <20>;
	};
	1440x2304@30ns {
		exynos,pmsk = <
			0x7 0xAA 0x1 0x8800 /* p m s k */
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0
			>;
		exynos,hs-clk = <930>;
		exynos,esc-clk = <20>;
	};
};



