	samsung,pins = "gpm4-0";
	samsung,pin-function = <2>;
	samsung,pin-pud = <3>;
	samsung,pin-pud-pdn = <3>;
	samsung,pin-drv = <0>;
};

&grip_i2c_sda {
	samsung,pins = "gpm5-0";
	samsung,pin-function = <2>;
	samsung,pin-pud = <3>;
	samsung,pin-pud-pdn = <3>;
	samsung,pin-drv = <0>;
};

&grip_wifi_i2c_scl {
	samsung,pins = "gpm4-0";
	samsung,pin-function = <2>;
	samsung,pin-pud = <3>;
	samsung,pin-pud-pdn = <3>;
	samsung,pin-drv = <0>;
};

