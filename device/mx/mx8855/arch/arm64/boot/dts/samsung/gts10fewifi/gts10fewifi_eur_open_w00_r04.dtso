&hsi2c_27 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	samsung,i2c-max-bus-freq = <400000>;

	sm5714@49{
		status = "okay";
		compatible = "siliconmitus,sm5714mfd";
		reg = <0x49>;
		pinctrl-names = "default";
		pinctrl-0 = <&if_pmic_irq>;
		sm5714,irq-gpio = <SEC_GPIO_REF(AP,gpa0,gpa0,5) 0>;
		sm5714,wakeup;
	};
};

&hsi2c_4 {
	i2c-gpio,delay-us = <5>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	samsung,i2c-max-bus-freq = <400000>;

	usbpd-sm5714@33 {
		status = "okay";
		compatible = "sm5714-usbpd";
		reg = <0x33>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbpd_irq
#if 1
				&usbpd_vbus_discharging
#endif
#if 0
				&usbpd_otg_det
#endif
		>;
		usbpd,usbpd_int = <SEC_GPIO_REF(AP,gpa0,gpa0,4) 0>;
#if 1
		usbpd,vbus_discharging = <SEC_GPIO_REF(AP,gpc8,gpc8,0) 0>;
#endif
#if 0
		usbpd,otg_det = <SEC_GPIO_REF(${usbpd_otg_det_gpio}) 0>;
#endif
#if 0
		vconn-en;
#endif
		support_pd_role_swap;
		pdic-manager {
			/* sink */
			pdic,max_power = <5000>;
			pdic_op_power = <2500>;
			pdic_max_voltage = <6000>;
			pdic_max_current = <2000>;
			pdic,min_current = <500>;
			pdic,pps_current = <4200>;

			pdic,giveback = <0>;
			pdic,usb_com_capable = <1>;
			pdic,no_usb_suspend = <1>;

			/* source */
			source,max_voltage = <5000>;
			source,min_voltage = <4000>;
			source,max_power = <2500>;
		};
	};
};


